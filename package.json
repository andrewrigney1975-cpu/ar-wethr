{
  "name": "wethr",
  "productName": "Wethr",
  "version": "1.0.0",
  "description": "Wethr weather app",
  "author": "Andrew Rigney",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron electron/make-icon.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "android:sync": "node -e \"require('fs').mkdirSync('www',{recursive:true});require('fs').copyFileSync('weather-app.html','www/index.html')\" && cap sync android"
  },
  "build": {
    "appId": "com.andrewrigney.wethr",
    "productName": "Wethr",
    "files": [
      "electron/main.js",
      "weather-app.html"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.weather"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
